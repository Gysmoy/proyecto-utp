<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">
    <session-config>
        <session-timeout>
            15
        </session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Los filtros se ejecutan en el orden de sus filter-mapping -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>pe.edu.utp.filter.EncodingFilter</filter-class>
    </filter>
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>pe.edu.utp.filter.CsrfFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>pe.edu.utp.filter.AuthFilter</filter-class>
    </filter>
    <!-- API REST: HTTP Basic en cada peticion, sin sesion ni token CSRF -->
    <filter>
        <filter-name>ApiAuthFilter</filter-name>
        <filter-class>pe.edu.utp.api.ApiAuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>ApiAuthFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/registro</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/accesos</url-pattern>
        <url-pattern>/accesos/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/accesos</url-pattern>
        <url-pattern>/accesos/*</url-pattern>
    </filter-mapping>
</web-app>
