<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>
    <!-- Sirve /login, /registro y /accesos sin la extension .xhtml -->
    <context-param>
        <param-name>jakarta.faces.AUTOMATIC_EXTENSIONLESS_MAPPING</param-name>
        <param-value>true</param-value>
    </context-param>
    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>
            15
        </session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>login.xhtml</welcome-file>
    </welcome-file-list>

    <!-- Los filtros se ejecutan en el orden de sus filter-mapping.
         CSRF: en las paginas lo cubre el ViewState de Faces y en las llamadas
         AJAX a la API, la cabecera X-CSRF-Token (ver ApiAuthFilter) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>pe.edu.utp.filter.EncodingFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>pe.edu.utp.filter.AuthFilter</filter-class>
    </filter>
    <!-- API REST (JAX-RS en /api): sesion web + token CSRF, o HTTP Basic.
         /api/auth (login, registro, logout) queda fuera porque es la puerta de entrada -->
    <filter>
        <filter-name>ApiAuthFilter</filter-name>
        <filter-class>pe.edu.utp.api.ApiAuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>ApiAuthFilter</filter-name>
        <url-pattern>/api/accesos</url-pattern>
        <url-pattern>/api/accesos/*</url-pattern>
        <url-pattern>/api/tipos</url-pattern>
        <url-pattern>/api/tipos/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/accesos</url-pattern>
        <url-pattern>/accesos.xhtml</url-pattern>
    </filter-mapping>

    <!-- PrimeExceptionHandlerFactory (faces-config.xml) redirige aqui, tambien en ajax -->
    <error-page>
        <exception-type>jakarta.faces.application.ViewExpiredException</exception-type>
        <location>/login?expirado=1</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error</location>
    </error-page>
</web-app>
